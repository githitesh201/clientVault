{
  "version": 2,
  "installCommand": "npm install --workspaces --include-workspace-root",
  "buildCommand": "npm run build --workspace frontend",
  "outputDirectory": "frontend/dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
